{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "skipLibCheck": true,
    "paths": {
      "@vpnsale/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@vpnsale/shared-typescript": [
        "./packages/shared-typescript/src/api-client.ts"
      ]
    }
  }
}
