{
  "scripts": {
    "lint": "eslint apps packages --ext .js,.mjs,.cjs,.ts,.tsx --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "workspaces": [
    "apps/customer-web",
    "apps/admin-web",
    "apps/reseller-web",
    "packages/shared-typescript",
    "packages/ui"
  ],
  "devDependencies": {
    "@types/node": "22.19.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.12",
    "typescript": "5.7.2"
  },
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <12"
  }
}
