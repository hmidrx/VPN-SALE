# Safe local placeholders only. Copy to .env and rotate values for real environments.
VPN_SALE_ENVIRONMENT=local
VPN_SALE_VERSION=0.0.0-milestone0
VPN_SALE_DATABASE_URL=postgresql+asyncpg://vpnsale:vpnsale_dev_password@localhost:5432/vpnsale
VPN_SALE_REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=vpnsale
POSTGRES_PASSWORD=vpnsale_dev_password
POSTGRES_DB=vpnsale
TELEGRAM_BOT_TOKEN=replace-with-local-development-token-only
PANEL_API_BASE_URL=do-not-use-real-panel-url-in-repository
PAYMENT_PROVIDER_SECRET=replace-with-local-placeholder

# Milestone 1A identity security placeholders only. Never use these values in production.
VPN_SALE_PASSWORD_ARGON2_TIME_COST=3
VPN_SALE_PASSWORD_ARGON2_MEMORY_COST=65536
VPN_SALE_PASSWORD_ARGON2_PARALLELISM=4
VPN_SALE_OPAQUE_TOKEN_BYTES=32
VPN_SALE_OPAQUE_TOKEN_HASH_SALT=vpnsale-identity-token-v1
# Development-only deterministic Fernet key (32 zero bytes, base64 encoded); replace outside local tests.
VPN_SALE_IDENTITY_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
VPN_SALE_IDENTITY_ENCRYPTION_KEY_VERSION=dev-v1

# Milestone 1B-A admin authentication placeholders only; replace outside git for real environments.
VPN_SALE_ADMIN_ACCESS_TOKEN_SIGNING_KEY=replace-with-random-admin-access-signing-key
VPN_SALE_ADMIN_ACCESS_TOKEN_KEY_ID=dev-v1
VPN_SALE_ADMIN_ACCESS_TOKEN_ISSUER=vpnsale-admin
VPN_SALE_ADMIN_ACCESS_TOKEN_AUDIENCE=vpnsale-admin-api
VPN_SALE_ADMIN_ACCESS_TOKEN_LIFETIME_SECONDS=900
VPN_SALE_ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800
VPN_SALE_ADMIN_SESSION_ABSOLUTE_LIFETIME_SECONDS=2592000
VPN_SALE_ADMIN_REFRESH_COOKIE_NAME=vpnsale_admin_refresh
VPN_SALE_ADMIN_REFRESH_COOKIE_PATH=/api/v1/admin/auth
VPN_SALE_ADMIN_REFRESH_COOKIE_DOMAIN=
VPN_SALE_ADMIN_REFRESH_COOKIE_SECURE=true
VPN_SALE_ADMIN_REFRESH_COOKIE_SAMESITE=lax
VPN_SALE_ADMIN_CSRF_SECRET=replace-with-random-csrf-secret
VPN_SALE_ADMIN_LOCKOUT_THRESHOLD=5
VPN_SALE_ADMIN_LOCKOUT_DURATION_SECONDS=900
VPN_SALE_ADMIN_LOGIN_RATE_LIMIT=10
VPN_SALE_ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
VPN_SALE_ADMIN_MFA_CHALLENGE_LIFETIME_SECONDS=300
VPN_SALE_ADMIN_TOTP_ISSUER=VPN-SALE Admin
VPN_SALE_ADMIN_TOTP_CLOCK_WINDOW=1
VPN_SALE_ADMIN_RECOVERY_CODE_COUNT=10

