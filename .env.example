# Safe local placeholders only. Copy to .env and rotate values for real environments.
VPN_SALE_ENVIRONMENT=local
VPN_SALE_VERSION=0.0.0-milestone0
VPN_SALE_DATABASE_URL=postgresql+asyncpg://vpnsale:vpnsale_dev_password@localhost:5432/vpnsale
VPN_SALE_REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=vpnsale
POSTGRES_PASSWORD=vpnsale_dev_password
POSTGRES_DB=vpnsale
TELEGRAM_BOT_TOKEN=replace-with-local-development-token-only
PANEL_API_BASE_URL=do-not-use-real-panel-url-in-repository
PAYMENT_PROVIDER_SECRET=replace-with-local-placeholder

# Milestone 1A identity security placeholders only. Never use these values in production.
VPN_SALE_PASSWORD_ARGON2_TIME_COST=3
VPN_SALE_PASSWORD_ARGON2_MEMORY_COST=65536
VPN_SALE_PASSWORD_ARGON2_PARALLELISM=4
VPN_SALE_OPAQUE_TOKEN_BYTES=32
VPN_SALE_OPAQUE_TOKEN_HASH_SALT=vpnsale-identity-token-v1
# Development-only deterministic Fernet key (32 zero bytes, base64 encoded); replace outside local tests.
VPN_SALE_IDENTITY_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
VPN_SALE_IDENTITY_ENCRYPTION_KEY_VERSION=dev-v1

# Milestone 1B-A admin authentication placeholders only; replace outside git for real environments.
VPN_SALE_ADMIN_ACCESS_TOKEN_SIGNING_KEY=replace-with-random-admin-access-signing-key
VPN_SALE_ADMIN_ACCESS_TOKEN_KEY_ID=dev-v1
VPN_SALE_ADMIN_ACCESS_TOKEN_ISSUER=vpnsale-admin
VPN_SALE_ADMIN_ACCESS_TOKEN_AUDIENCE=vpnsale-admin-api
VPN_SALE_ADMIN_ACCESS_TOKEN_LIFETIME_SECONDS=900
VPN_SALE_ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800
VPN_SALE_ADMIN_SESSION_ABSOLUTE_LIFETIME_SECONDS=2592000
VPN_SALE_ADMIN_REFRESH_COOKIE_NAME=vpnsale_admin_refresh
VPN_SALE_ADMIN_REFRESH_COOKIE_PATH=/api/v1/admin/auth
VPN_SALE_ADMIN_REFRESH_COOKIE_DOMAIN=
VPN_SALE_ADMIN_REFRESH_COOKIE_SECURE=true
VPN_SALE_ADMIN_REFRESH_COOKIE_SAMESITE=lax
VPN_SALE_ADMIN_CSRF_SECRET=replace-with-random-csrf-secret
VPN_SALE_ADMIN_LOCKOUT_THRESHOLD=5
VPN_SALE_ADMIN_LOCKOUT_DURATION_SECONDS=900
VPN_SALE_ADMIN_LOGIN_RATE_LIMIT=10
VPN_SALE_ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
VPN_SALE_ADMIN_MFA_CHALLENGE_LIFETIME_SECONDS=300
VPN_SALE_ADMIN_TOTP_ISSUER=VPN-SALE Admin
VPN_SALE_ADMIN_TOTP_CLOCK_WINDOW=1
VPN_SALE_ADMIN_RECOVERY_CODE_COUNT=10

# Milestone 1C-A customer Telegram authentication placeholders
VPN_SALE_TELEGRAM_BOT_TOKEN=
VPN_SALE_TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
VPN_SALE_TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=60
VPN_SALE_TELEGRAM_INIT_DATA_MAX_LENGTH=4096
VPN_SALE_CUSTOMER_ACCESS_TOKEN_SIGNING_KEY=dev-disposable-customer-access-token-signing-key-change-me
VPN_SALE_CUSTOMER_ACCESS_TOKEN_ISSUER=vpnsale-customer
VPN_SALE_CUSTOMER_ACCESS_TOKEN_AUDIENCE=vpnsale-customer-api
VPN_SALE_CUSTOMER_REFRESH_COOKIE_NAME=vpnsale_customer_refresh
VPN_SALE_CUSTOMER_REFRESH_COOKIE_PATH=/api/v1/customer/auth
VPN_SALE_CUSTOMER_REFRESH_COOKIE_SECURE=true
VPN_SALE_CUSTOMER_REFRESH_COOKIE_SAMESITE=lax
VPN_SALE_CUSTOMER_CSRF_SECRET=dev-disposable-customer-csrf-secret-change-me
VPN_SALE_FAKE_CUSTOMER_AUTH_ENABLED=false

# Milestone 1C-B1 public customer frontend placeholders (safe for browser exposure)
NEXT_PUBLIC_CUSTOMER_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_CUSTOMER_APP_NAME=VPN-SALE
NEXT_PUBLIC_CUSTOMER_FAKE_TELEGRAM=false

# Milestone 1C-B2 Telegram bot runtime placeholders only.
VPN_SALE_BOT_ENABLED=false
VPN_SALE_BOT_MODE=disabled
VPN_SALE_TELEGRAM_BOT_TOKEN=
VPN_SALE_TELEGRAM_BOT_USERNAME=
VPN_SALE_TELEGRAM_BOT_DISPLAY_NAME=VPN-SALE
VPN_SALE_TELEGRAM_WEBHOOK_BASE_URL=https://bot.example.invalid
VPN_SALE_TELEGRAM_WEBHOOK_PATH=/telegram/webhook
VPN_SALE_TELEGRAM_WEBHOOK_SECRET_TOKEN=
VPN_SALE_TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
VPN_SALE_TELEGRAM_ALLOWED_UPDATES=message,callback_query
VPN_SALE_TELEGRAM_POLLING_TIMEOUT_SECONDS=30
VPN_SALE_CUSTOMER_MINI_APP_URL=https://customer.example.invalid
VPN_SALE_CUSTOMER_MINI_APP_ALLOWED_HOSTS=customer.example.invalid
VPN_SALE_TELEGRAM_DEFAULT_LOCALE=fa
VPN_SALE_TELEGRAM_SUPPORTED_LOCALES=fa,en
VPN_SALE_TELEGRAM_UPDATE_IDEMPOTENCY_TTL_SECONDS=86400
VPN_SALE_TELEGRAM_COMMAND_RATE_LIMIT=12
VPN_SALE_TELEGRAM_COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
VPN_SALE_TELEGRAM_NAVIGATION_RATE_LIMIT=30
VPN_SALE_TELEGRAM_NAVIGATION_RATE_LIMIT_WINDOW_SECONDS=10
VPN_SALE_TELEGRAM_MUTATION_RATE_LIMIT=1
VPN_SALE_TELEGRAM_MUTATION_RATE_LIMIT_WINDOW_SECONDS=3
VPN_SALE_TELEGRAM_SENSITIVE_RATE_LIMIT=12
VPN_SALE_TELEGRAM_SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60
VPN_SALE_TELEGRAM_THROTTLE_NOTICE_COOLDOWN_SECONDS=3
VPN_SALE_TELEGRAM_HELP_URL=
VPN_SALE_TELEGRAM_PRIVACY_URL=

# Milestone 1D-A management controls
ADMIN_INVITATION_LIFETIME_HOURS=72
ADMIN_INVITATION_ACCEPT_RATE_LIMIT=5
MANAGEMENT_MAX_PAGE_SIZE=100
AUDIT_QUERY_MAX_DAYS=90
SECURITY_EVENT_NOTE_MAX_LENGTH=500
PROTECT_FINAL_SUPER_ADMIN=true

# Milestone 2-A catalog defaults
VPN_SALE_CATALOG_QUOTE_LIFETIME_SECONDS=900
VPN_SALE_CATALOG_QUOTE_IDEMPOTENCY_LIFETIME_SECONDS=86400
VPN_SALE_CATALOG_DEFAULT_CURRENCY=IRR
VPN_SALE_CATALOG_MONEY_UNIT=rial
VPN_SALE_CATALOG_DEFAULT_LOCALE=fa
VPN_SALE_CATALOG_MAX_PAGE_SIZE=100

# Milestone 3-A1 wallet policy defaults are database-backed; no new environment variables are required.

# Phase 1A.2 password capabilities are implemented but fail closed by default.
VPN_SALE_PUBLIC_ACCOUNT_REGISTRATION_ENABLED=false
VPN_SALE_PASSWORD_ACCOUNT_LOGIN_ENABLED=false
VPN_SALE_CUSTOMER_PASSWORD_MIN_LENGTH=12
VPN_SALE_CUSTOMER_PASSWORD_MAX_LENGTH=512
VPN_SALE_CUSTOMER_PASSWORD_LOCKOUT_THRESHOLD=5
VPN_SALE_CUSTOMER_PASSWORD_LOCKOUT_DURATION_SECONDS=900
VPN_SALE_ACCOUNT_EMAIL_VERIFICATION_ENABLED=false
VPN_SALE_ACCOUNT_RECOVERY_ENABLED=false
VPN_SALE_TELEGRAM_ACCOUNT_LINKING_ENABLED=false
VPN_SALE_UNIFIED_ADMIN_IDENTITY_ENABLED=false
# Manual reviewed top-ups are fail-closed unless explicitly enabled.
VPN_SALE_MANUAL_CARD_TOPUPS_ENABLED=false
VPN_SALE_MANUAL_TOPUP_PRIVATE_UPLOAD_ROOT=/var/lib/vpnsale/private/manual-topups
VPN_SALE_MANUAL_TOPUP_MAX_RECEIPT_BYTES=5242880
VPN_SALE_MANUAL_TOPUP_IMAGE_DIMENSION_LIMIT=8192
