VPN_SALE_TELEGRAM_BOT_TOKEN=
VPN_SALE_TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
VPN_SALE_TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=60
VPN_SALE_TELEGRAM_INIT_DATA_MAX_LENGTH=4096
VPN_SALE_CUSTOMER_ACCESS_TOKEN_SIGNING_KEY=dev-disposable-customer-access-token-signing-key-change-me
