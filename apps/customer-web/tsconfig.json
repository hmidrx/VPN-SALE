{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@vpnsale/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@vpnsale/shared-typescript": [
        "../../packages/shared-typescript/src/api-client.ts"
      ],
      "@vpnsale/telegram-webapp": [
        "../../packages/telegram-webapp/src/index.ts"
      ]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
