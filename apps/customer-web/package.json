{
  "name": "@vpnsale/customer-web",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "node ../../scripts/lint-workspace.mjs .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && vitest run src/tests/telegram-bridge.test.ts && node --experimental-strip-types src/tests/public-config.test.mjs && node src/tests/customer-static.test.mjs && node src/tests/runtime-configuration.test.mjs",
    "test:public-config": "node --experimental-strip-types src/tests/public-config.test.mjs",
    "test:public-config-build": "node src/tests/public-config-build.test.mjs",
    "build": "next build && node src/tests/telegram-bridge-build.test.mjs",
    "start": "next start -H 0.0.0.0 -p 3000"
  },
  "dependencies": {
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vpnsale/shared-typescript": "0.0.0",
    "@vpnsale/telegram-webapp": "0.0.0",
    "@vpnsale/ui": "0.0.0",
    "next": "16.3.0-canary.93",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.7.2"
  }
}
