# Copy to /opt/vpn-sale-runtime/test.env and replace all placeholders. Do not commit runtime files.
VPN_SALE_ENVIRONMENT=TEST
POSTGRES_USER=vpnsale_test
POSTGRES_DB=vpnsale_test
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
VPN_SALE_DATABASE_URL=postgresql+asyncpg://vpnsale_test:REPLACE_WITH_RANDOM_POSTGRES_PASSWORD@postgres:5432/vpnsale_test
VPN_SALE_REDIS_URL=redis://redis:6379/0
VPN_SALE_IDENTITY_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
VPN_SALE_IDENTITY_ENCRYPTION_KEY_VERSION=test-v1
VPN_SALE_ADMIN_ACCESS_TOKEN_SIGNING_KEY=REPLACE_WITH_RANDOM_ADMIN_SIGNING_KEY
VPN_SALE_ADMIN_ACCESS_TOKEN_KEY_ID=test-v1
VPN_SALE_CUSTOMER_ACCESS_TOKEN_SIGNING_KEY=REPLACE_WITH_RANDOM_CUSTOMER_SIGNING_KEY
VPN_SALE_CUSTOMER_ACCESS_TOKEN_KEY_ID=test-v1
VPN_SALE_ADMIN_CSRF_SECRET=REPLACE_WITH_RANDOM_ADMIN_CSRF_SECRET
VPN_SALE_CUSTOMER_CSRF_SECRET=REPLACE_WITH_RANDOM_CUSTOMER_CSRF_SECRET
VPN_SALE_PUBLIC_APP_ORIGIN=https://app.dr-ping.com
VPN_SALE_API_PUBLIC_ORIGIN=https://api.dr-ping.com
VPN_SALE_SUBSCRIPTION_PUBLIC_ORIGIN=https://sub.dr-ping.com
VPN_SALE_CORS_ALLOWED_ORIGINS=["https://app.dr-ping.com","https://admin.dr-ping.com","https://reseller.dr-ping.com"]
VPN_SALE_CUSTOMER_API_FRONTEND_URL=https://api.dr-ping.com
VPN_SALE_CUSTOMER_APP_NAME=Dr Ping
VPN_SALE_TELEGRAM_BOT_USERNAME=REPLACE_WITH_BOT_USERNAME_WITHOUT_AT
VPN_SALE_TELEGRAM_BOT_TOKEN=REPLACE_WITH_TEST_BOT_TOKEN
VPN_SALE_BOT_ENABLED=false
VPN_SALE_BOT_MODE=disabled
VPN_SALE_CUSTOMER_MINI_APP_URL=https://app.dr-ping.com
VPN_SALE_CUSTOMER_MINI_APP_ALLOWED_HOSTS=app.dr-ping.com
VPN_SALE_TELEGRAM_ALLOWED_UPDATES=message,callback_query
VPN_SALE_TELEGRAM_POLLING_TIMEOUT_SECONDS=30
VPN_SALE_TELEGRAM_UPDATE_IDEMPOTENCY_TTL_SECONDS=86400
VPN_SALE_TELEGRAM_COMMAND_RATE_LIMIT=12
VPN_SALE_TELEGRAM_COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
VPN_SALE_TELEGRAM_RATE_LIMIT_KEY=REPLACE_WITH_RANDOM_BOT_RATE_LIMIT_KEY
# Webhook settings are unused when VPN_SALE_BOT_MODE=polling.
VPN_SALE_TELEGRAM_WEBHOOK_BASE_URL=
VPN_SALE_TELEGRAM_WEBHOOK_PATH=/telegram/webhook
VPN_SALE_TELEGRAM_WEBHOOK_SECRET_TOKEN=
VPN_SALE_TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
VPN_SALE_ADMIN_REFRESH_COOKIE_DOMAIN=.dr-ping.com
VPN_SALE_ADMIN_REFRESH_COOKIE_SECURE=true
VPN_SALE_ADMIN_REFRESH_COOKIE_SAMESITE=none
VPN_SALE_CUSTOMER_REFRESH_COOKIE_DOMAIN=.dr-ping.com
VPN_SALE_CUSTOMER_REFRESH_COOKIE_SECURE=true
VPN_SALE_CUSTOMER_REFRESH_COOKIE_SAMESITE=none
VPN_SALE_FAKE_CUSTOMER_AUTH_ENABLED=false
VPN_SALE_PAYMENT_FAKE_SUCCESS_ENABLED=false
VPN_SALE_PAYMENT_FAKE_SUCCESS_PUBLIC_ENABLED=false
VPN_SALE_PROVIDER_WRITES_ENABLED=false
VPN_SALE_BACKUP_DESTINATION_URL=file:///var/lib/vpn-sale/backups/test-server
VPN_SALE_WORKER_CONCURRENCY=1
