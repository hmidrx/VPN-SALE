# Sanitized staging example; replace all values through your secret manager.
VPN_SALE_ENVIRONMENT=STAGING
VPN_SALE_PUBLIC_APP_ORIGIN=https://staging.example.invalid
VPN_SALE_API_PUBLIC_ORIGIN=https://api.staging.example.invalid
VPN_SALE_SUBSCRIPTION_PUBLIC_ORIGIN=https://sub.staging.example.invalid
VPN_SALE_DATABASE_URL=postgresql+asyncpg://user:REDACTED@postgres:5432/vpnsale
VPN_SALE_REDIS_URL=redis://redis:6379/0
VPN_SALE_IDENTITY_ENCRYPTION_KEY=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_ADMIN_ACCESS_TOKEN_SIGNING_KEY=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_CUSTOMER_ACCESS_TOKEN_SIGNING_KEY=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_ADMIN_CSRF_SECRET=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_CUSTOMER_CSRF_SECRET=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_TELEGRAM_BOT_TOKEN=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_BACKUP_DESTINATION_URL=s3://vpnsale-staging-backups/example-prefix
