# Sanitized production reference. Do not commit real values.
VPN_SALE_ENVIRONMENT=PRODUCTION
POSTGRES_USER=vpnsale
POSTGRES_DB=vpnsale
POSTGRES_PASSWORD=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_PUBLIC_APP_ORIGIN=https://app.example.invalid
VPN_SALE_API_PUBLIC_ORIGIN=https://api.example.invalid
VPN_SALE_SUBSCRIPTION_PUBLIC_ORIGIN=https://sub.example.invalid
VPN_SALE_CUSTOMER_API_FRONTEND_URL=https://api.example.invalid
VPN_SALE_CORS_ALLOWED_ORIGINS=["https://app.example.invalid","https://admin.example.invalid","https://reseller.example.invalid"]
VPN_SALE_DATABASE_URL=postgresql+asyncpg://vpnsale:REDACTED@postgres:5432/vpnsale
DATABASE_URL=postgresql+asyncpg://vpnsale:REDACTED@postgres:5432/vpnsale
VPN_SALE_SYNC_DATABASE_URL=postgresql://vpnsale:REDACTED@postgres:5432/vpnsale
VPN_SALE_REDIS_URL=redis://redis:6379/0
VPN_SALE_IDENTITY_ENCRYPTION_KEY=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_IDENTITY_ENCRYPTION_KEY_VERSION=prod-v1
VPN_SALE_ADMIN_ACCESS_TOKEN_SIGNING_KEY=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_ADMIN_ACCESS_TOKEN_KEY_ID=prod-v1
VPN_SALE_CUSTOMER_ACCESS_TOKEN_SIGNING_KEY=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_CUSTOMER_ACCESS_TOKEN_KEY_ID=prod-v1
VPN_SALE_ADMIN_CSRF_SECRET=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_CUSTOMER_CSRF_SECRET=REDACTED_FROM_SECRET_MANAGER
PROVIDER_VAULT_MASTER_KEY_B64=REDACTED_FROM_SECRET_MANAGER
PROVIDER_VAULT_KEY_VERSION=prod-v1
VPN_SALE_PROVIDER_WRITES_ENABLED=false
VPN_SALE_FAKE_CUSTOMER_AUTH_ENABLED=false
VPN_SALE_MANUAL_CARD_TOPUPS_ENABLED=true
VPN_SALE_MANUAL_TOPUP_PRIVATE_UPLOAD_ROOT=/var/lib/vpnsale/private/manual-topups
VPN_SALE_SUPPORT_PRIVATE_UPLOAD_ROOT=/var/lib/vpnsale/private/support
VPN_SALE_FORWARDED_ALLOW_IPS=127.0.0.1
VPN_SALE_BACKUP_DESTINATION_URL=s3://vpnsale-production-backups/example-prefix
VPN_SALE_BACKUP_MASTER_KEY_B64=REDACTED_FROM_SECRET_MANAGER

# Values also consumed while building the public web bundles.
VPN_SALE_CUSTOMER_APP_NAME=VPN-SALE
VPN_SALE_TELEGRAM_BOT_USERNAME=REPLACE_WITH_BOT_USERNAME_WITHOUT_AT

# Host Caddy variables (not injected into browser bundles).
VPN_SALE_TLS_EMAIL=admin@example.invalid
VPN_SALE_CUSTOMER_HOST=app.example.invalid
VPN_SALE_ADMIN_HOST=admin.example.invalid
VPN_SALE_RESELLER_HOST=reseller.example.invalid
VPN_SALE_API_HOST=api.example.invalid
VPN_SALE_SUBSCRIPTION_HOST=sub.example.invalid
VPN_SALE_BOT_HOST=bot.example.invalid

# Telegram bot production ingress. Replace every REDACTED/example value outside Git.
VPN_SALE_BOT_ENABLED=true
VPN_SALE_BOT_MODE=webhook
VPN_SALE_TELEGRAM_BOT_TOKEN=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_TELEGRAM_WEBHOOK_BASE_URL=https://bot.example.invalid
VPN_SALE_TELEGRAM_WEBHOOK_PATH=/telegram/webhook
VPN_SALE_TELEGRAM_WEBHOOK_SECRET_TOKEN=REDACTED_FROM_SECRET_MANAGER
VPN_SALE_TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
VPN_SALE_TELEGRAM_WEBHOOK_REQUEST_SIZE_LIMIT=262144
VPN_SALE_TELEGRAM_WEBHOOK_LISTEN_HOST=0.0.0.0
VPN_SALE_TELEGRAM_WEBHOOK_LISTEN_PORT=8081
VPN_SALE_TELEGRAM_INTERNAL_API_URL=http://api:8000
VPN_SALE_TELEGRAM_INTERNAL_TOKEN_FILE=/run/secrets/telegram-internal-token
VPN_SALE_CUSTOMER_MINI_APP_URL=https://app.example.invalid
VPN_SALE_CUSTOMER_MINI_APP_ALLOWED_HOSTS=app.example.invalid
VPN_SALE_TELEGRAM_DEFAULT_LOCALE=fa
VPN_SALE_TELEGRAM_SUPPORTED_LOCALES=fa
